{
  "name": "pf2e-flank-vision",
  "version": "0.2.0",
  "description": "Live PF2e flanking feedback for Foundry VTT v14.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/flank-vision.js",
    "watch": "pnpm run build -- --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@dfreds/foundry-types": "^14.366.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
